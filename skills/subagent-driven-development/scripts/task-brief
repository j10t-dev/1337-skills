#!/usr/bin/env bash
# Extract the shared plan preamble and one task into a self-contained brief.
# The preamble carries global constraints, shared contracts and required context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.agents/sdd/task-<N>-brief.md
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${n}-brief.md"
fi

if ! awk -v n="$n" '
  /^[ \t]*(```+|~~~+)/ {
    line = $0
    sub(/^[ \t]*/, "", line)
    match(line, /^`+|^~+/)
    marker = substr(line, 1, RLENGTH)
    rest = substr(line, RLENGTH + 1)
    if (!fence) {
      fence = substr(marker, 1, 1)
      width = length(marker)
    } else if (substr(marker, 1, 1) == fence && length(marker) >= width && rest ~ /^[ \t]*$/) {
      fence = ""
    }
  }
  !fence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    seen_task = 1
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
    if (intask) found = 1
  }
  !seen_task { preamble = preamble $0 "\n" }
  intask { task = task $0 "\n" }
  END {
    if (!found) exit 3
    printf "%s%s", preamble, task
  }
' "$plan" > "$out"; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "$out"

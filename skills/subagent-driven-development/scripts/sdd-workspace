#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for short-lived
# artifacts: task briefs, implementer reports, review packages, progress ledger.
# Print the directory's absolute path.
#
# Lives in the working tree (not .jj/ or .git/) because harnesses protect those
# paths and deny agent writes there. A self-ignoring .gitignore (honoured by jj)
# keeps the workspace out of status and out of accidental commits.
#
# Usage: sdd-workspace
set -euo pipefail

root=$(jj root)
dir="$root/.agents/sdd"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd

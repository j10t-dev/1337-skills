#!/usr/bin/env bash
# Generate a review package: stat summary and full diff between two
# working-copy snapshots, written to a file the reviewer reads in one call.
#
# Usage: review-package BASE HEAD [OUTFILE]
# BASE and HEAD are jj commit IDs (or `@` for the current working copy).
# Record BASE before dispatching an implementer with:
#   jj log -r @ --no-graph -T commit_id
# Commit IDs are immutable snapshots and stay resolvable after the working
# copy amends (the old snapshot is hidden, not gone), so the diff captures
# exactly the task's edits even though all tasks accumulate in one change.
# Never pass a change ID as BASE: change IDs follow the amended change, so
# the "base" would already contain the task's work and the diff would be
# empty.
# Default OUTFILE: <workspace>/review-<base>..<head>-<ts>-<pid>.diff
# (the timestamp+PID keeps a re-review after fixes from overwriting the
#  prior package).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

# Resolve a revision to exactly one commit's short ID, or fail. In jj a
# revset matching no commits exits 0 with empty output, and one matching
# several would make --from/--to and the filename ambiguous — so enforce a
# singleton.
resolve_one() {
  local rev=$1 name=$2 ids n
  ids=$(jj log --no-graph -r "$rev" -T 'commit_id.short() ++ "\n"' 2>/dev/null) \
    || { echo "bad $name: $rev (revset error)" >&2; exit 2; }
  # awk counts non-empty lines and always exits 0; `grep -c` exits 1 on zero
  # matches, which under `set -e` would abort before the diagnostic below.
  n=$(printf '%s' "$ids" | awk 'NF { c++ } END { print c + 0 }')
  [ "$n" -eq 1 ] || { echo "bad $name: $rev resolves to $n commits (need exactly 1)" >&2; exit 2; }
  printf '%s' "$ids" | grep .
}

bs=$(resolve_one "$base" BASE)
hs=$(resolve_one "$head" HEAD)

# A change ID passed as BASE resolves to the *amended* change — i.e. the same
# commit as HEAD — so the package would be empty and the review would pass
# vacuously. Catch it here rather than shipping a hollow package.
if [ "$bs" = "$hs" ]; then
  echo "BASE and HEAD resolve to the same commit ($bs) — was BASE a change ID?" >&2
  echo "Record BASE as a commit ID before dispatch: jj log -r @ --no-graph -T commit_id" >&2
  exit 3
fi

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/review-${bs}..${hs}-$(date +%Y%m%d%H%M%S)-$$.diff"
fi

body=$(jj diff --git --from "$bs" --to "$hs")
if [ -z "$body" ]; then
  echo "empty diff between ${bs} and ${hs} — nothing to review." >&2
  echo "Either the implementer made no edits, or BASE already contains the task's work." >&2
  exit 3
fi

{
  echo "# Review package: ${bs}..${hs}"
  echo
  echo "## Files changed"
  jj diff --stat --from "$bs" --to "$hs"
  echo
  echo "## Diff"
  printf '%s\n' "$body"
} > "$out"

echo "$out"
